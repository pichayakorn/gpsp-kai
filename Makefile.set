# Build settings for gpSP kai, included by eboot/Makefile.
# The version number is in version.txt (updated by the release workflow).

# 1: enable debug logging and the Debug mode menu option
USE_DEBUG = 0

# 1: build the ad-hoc WLAN (link cable) code
USE_ADHOC = 0

# 1: set MEMSIZE=1 so PSP-2000 and later can use the extra 32 MB of memory.
# 0: use takka's old USE_EXT_MEM code, which accesses that memory directly.
PSP_LARGE_MEMORY = 1

# 1: also build the C interpreter ARM core, selectable as "Emulate Core" in
# the menu (the MIPS dynarec stays the default)
USE_C_CORE = 0

# 1: build the 4.0 app UI (src/ui/, work in progress; the old menu stays the
# default until it is finished). Hold R while kai starts for the UI
# benchmark screen.
UI4 = 0

# 1: test build that holds back the PSP-2000/3000's extra 28 MB at start,
# so memory is as tight as on a PSP-1000 (there is no PSP-1000 to test on)
SIM_PSP1000 = 0
